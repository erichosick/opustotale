{
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.allowDangerouslySkipPermissions": true,
  "eslint.probe": [
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "toml",
    "markdown",
    "css"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.claude.json": true,
    "**/.credentials.json": true,
    "**/mcp-needs-auth-cache.json": true,
    "**/history.jsonl": true,
    "**/stats-cache.json": true,
    ".claude/sessions": true,
    ".claude/session-env": true,
    ".claude/shell-snapshots": true,
    ".claude/file-history": true,
    ".claude/projects": true,
    ".claude/todos": true,
    ".claude/tasks": true,
    ".claude/plans": true,
    ".claude/memory": true,
    ".claude/cache": true,
    ".claude/paste-cache": true,
    ".claude/downloads": true,
    ".claude/backups": true,
    ".claude/ide": true,
    ".claude/debug": true,
    ".claude/telemetry": true,
    ".claude/statsig": true,
    ".claude/plugins": true
  }
}
